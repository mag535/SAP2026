    DialogueText: END OF CONVERSATION
    cost: {fileID: 0}
    trade: {fileID: 0}
    flag: 
    Position: {x: 1656, y: 350.4}
  - type: 0
    Guid: 614aff0a-ad10-474d-8602-d33ffaae2f99
    speaker: Fox
    DialogueText: '"If you find anything in the bar, be sure to show it to me so
      I can explain what those objects are." '
    cost: {fileID: 0}
    trade: {fileID: 0}
    flag: 
    Position: {x: 418.4, y: 257.6}
  - type: 2
    Guid: 29909da4-86ce-4960-898d-2308afb0e612
    speaker: Fox
    DialogueText: "\u201CIf you want more information, you should <color=\"yellow\">
      go to the bar</color>. But the bartender won\u2019t give you that information
      for free..\""
    cost: {fileID: 0}
    trade: {fileID: 11400000, guid: 8d822821a65625847bb4f867a5a496e6, type: 2}
    flag: 
    Position: {x: -9.6, y: -167.2}
  - type: 3
    Guid: a5bfc3c6-9ec7-4098-b789-8ddd1a7847ef
    speaker: Fox
    DialogueText: '"You got any coin on you?"'
    cost: {fileID: 0}
    trade: {fileID: 0}
    flag: OpenBarDoor
    Position: {x: 866.4, y: -144}
  - type: 2
    Guid: 99d7adb8-4192-4b9b-8267-d8f0aec95c70
    speaker: Fox
    DialogueText: "\"\u201CNo? I usually <color=\"yellow\">check the telephone booth</color>
      for spare change. If your luck is any good, you\u2019ll find something in there.\u201D "
    cost: {fileID: 0}
    trade: {fileID: 11400000, guid: c0ed06e2ffa20694e89703e6be73dcb0, type: 2}
    flag: 
    Position: {x: 18.4, y: 44.799995}
  - type: 0
    Guid: f72eaba8-902e-4670-9e17-3d830e534368
    speaker: Fox
    DialogueText: '"You can show me things by clicking on objects in your inventory
      while talking to me, or clicking yellow clues in your notebook while talking
      to me. "'
    cost: {fileID: 0}
    trade: {fileID: 0}
    flag: 
    Position: {x: 799.2, y: 532.8}
  - type: 0
    Guid: 606247e9-5022-4bec-83f5-5a4804d8d15c
    speaker: Fox
    DialogueText: '"Hello, little carp. You were sent here to find the Dragon Gate,
      right? That''s why everyone comes here." . '
    cost: {fileID: 0}
    trade: {fileID: 0}
    flag: 
    Position: {x: 17.6, y: -777.60004}
  - type: 2
    Guid: 13eb1a8e-13ae-434c-84f8-82c11c5bb7c9
    speaker: Fox
    DialogueText: '"There are three gates around the map, <color="yellow">red, green,
      and gold</color>. One of them is the Dragon Gate you seek." '
    cost: {fileID: 0}
    trade: {fileID: 11400000, guid: b9c264cce1d8264418a39a7c53088682, type: 2}
    flag: 
    Position: {x: -138.4, y: -527.2}
  - type: 0
    Guid: 25c7a2be-210b-4b65-83df-eac23fcd351b
    speaker: Fox
    DialogueText: '"Explore the area and talk to the residents here to get clues
      about the Dragon Gate. They should help you determine which of the three is
      the real Dragon Gate." '
    cost: {fileID: 0}
    trade: {fileID: 0}
    flag: 
    Position: {x: 730.4, y: -608.80005}
